# Copy to .env before building. Baked into the extension's JS bundle at build
# time — the extension must be rebuilt after changing these.

# The Job Tracker API. Must also be listed in manifest.json's host_permissions
# or the popup's fetch calls will be blocked.
VITE_API_BASE_URL=http://localhost:3000

# The Job Tracker web app, used only for the "View in Job Tracker" link shown
# after a successful save.
VITE_FRONTEND_URL=http://localhost:5173

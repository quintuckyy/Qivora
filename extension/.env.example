# Copy to .env before building. Baked into the extension's JS bundle at build
# time — the extension must be rebuilt after changing these.

# The Qivora API. Must also be listed in manifest.json's host_permissions
# or the popup's fetch calls will be blocked. In production, point this at the
# deployed backend and update host_permissions to match; the backend must also
# list this build's chrome-extension://<id> origin in FRONTEND_ORIGIN.
VITE_API_BASE_URL=http://localhost:3000

# The Qivora web app, used only for the "View in Qivora" link shown after a
# successful save.
VITE_FRONTEND_URL=http://localhost:5173

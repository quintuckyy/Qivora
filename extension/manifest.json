{
  "manifest_version": 3,
  "name": "Job Tracker — LinkedIn Companion",
  "version": "0.1.0",
  "description": "Save a job posting from LinkedIn straight into your Job Application Tracker.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Job Tracker"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

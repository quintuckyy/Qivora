{
  "manifest_version": 3,
  "name": "Qivora",
  "version": "0.2.0",
  "description": "Save a job posting from LinkedIn, Indeed, or JobStreet straight into Qivora, your job application tracker.",
  "icons": {
    "16": "icon-128.png",
    "32": "icon-128.png",
    "48": "icon-128.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Qivora",
    "default_icon": {
      "16": "icon-128.png",
      "32": "icon-128.png",
      "48": "icon-128.png",
      "128": "icon-128.png"
    }
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://*.jobstreet.com/*",
    "https://*.jobstreet.com.ph/*",
    "https://*.jobstreet.com.sg/*",
    "https://*.jobstreet.co.id/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://*.indeed.com/*",
        "https://*.jobstreet.com/*",
        "https://*.jobstreet.com.ph/*",
        "https://*.jobstreet.com.sg/*",
        "https://*.jobstreet.co.id/*"
      ],
      "run_at": "document_idle",
      "js": ["content.js"]
    }
  ]
}

# Copy to .env.local to override. Defaults to the backend's local dev port.
VITE_API_BASE_URL=http://localhost:3000

# Google OAuth client ID for the "Continue with Google" login button — same
# value as the backend's GOOGLE_CLIENT_ID (see backend/.env.example). Not a
# secret; safe to ship in the browser bundle. Leave blank to leave the button
# in its disabled "coming soon" state.
VITE_GOOGLE_CLIENT_ID=

# Copy to .env for local (non-Docker) development. In docker-compose, these are
# supplied by the compose file / root .env instead — see ../.env.example.

DATABASE_URL="postgresql://jobtracker:jobtracker@localhost:5432/jobtracker?schema=public"

# Required. The app fails fast at boot if this is missing.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

PORT=3000

# Comma-separated list of origins allowed to call this API (e.g. the deployed
# frontend's URL). In production (NODE_ENV=production), CORS is disabled unless
# this is set. In any other environment, omitting it allows all origins for
# local development convenience.
# The companion browser extension (chrome-extension://<id>) is allowed
# automatically outside production, since its id changes on every unpacked
# reload; in production, add its chrome-extension:// origin to this list.
FRONTEND_ORIGIN=http://localhost:5173

# NODE_ENV=production tightens the CORS default above and is set automatically
# in the Docker image. Leave unset for local development.
# NODE_ENV=production

# --- Gmail email sync (optional) ---
# The whole feature is opt-in: without these set, the app boots and runs
# exactly as before — the /email-sync endpoints just fail with a clear error
# if called. Get GOOGLE_CLIENT_ID/SECRET from a Google Cloud OAuth 2.0 Client
# ID (Web application type); GOOGLE_OAUTH_REDIRECT_URI must exactly match one
# of that client's authorized redirect URIs and point at the frontend's
# /email-sync page (this app completes the OAuth code exchange from there,
# not from a backend route — see extension/README-style notes in
# email-sync/README.md). Required scope: gmail.readonly (+ userinfo.email).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/email-sync

# --- "Continue with Google" sign-in (optional) ---
# A second, unrelated use of the same GOOGLE_CLIENT_ID above — the "Continue
# with Google" button on the login page (POST /auth/google). It's a plain
# `openid email` sign-in grant handled entirely client-side via Google
# Identity Services, so it does NOT use GOOGLE_CLIENT_SECRET or
# GOOGLE_OAUTH_REDIRECT_URI at all; the backend only verifies the resulting
# access token against Google and never sees a client secret for it. Opt-in
# like Gmail sync: leave GOOGLE_CLIENT_ID blank and the button just shows a
# "coming soon" state. The one extra setup step this needs in Google Cloud
# Console (Credentials → this OAuth client → Authorized JavaScript origins)
# is adding the frontend's origin (e.g. http://localhost:5173) — separate
# from the redirect URI above, since this flow never redirects anywhere.
# The frontend also needs the same client ID — see frontend/.env.example's
# VITE_GOOGLE_CLIENT_ID.

# Encrypts Gmail OAuth tokens at rest (AES-256-GCM). Any long random string;
# changing it invalidates every stored Gmail connection (users just
# reconnect). Required only once GOOGLE_CLIENT_ID is set.
EMAIL_SYNC_ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- Transactional email (optional) ---
# Used for password-reset emails — deliberately a real mail provider
# (Brevo), never a user's own connected Gmail account. Also opt-in like
# Gmail sync: without BREVO_API_KEY/MAIL_FROM set, forgot-password still
# works (the app boots fine and returns its normal generic response) — it
# just logs the reset link instead of emailing it, which is enough for local
# dev. Get BREVO_API_KEY from Brevo's dashboard (Settings → SMTP & API →
# API Keys). MAIL_FROM must be a sender verified with Brevo (Settings →
# Senders, Domains & Dedicated IPs) — either a bare address
# (noreply@yourdomain.com) or "Name <noreply@yourdomain.com>".
BREVO_API_KEY=
MAIL_FROM=

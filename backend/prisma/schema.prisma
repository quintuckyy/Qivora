generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ApplicationStatus {
  APPLIED
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
}

enum DetectedEmailType {
  APPLICATION_RECEIVED
  ASSESSMENT
  INTERVIEW
  REJECTION
  OFFER
  OTHER
}

enum SuggestedAction {
  CREATE_APPLICATION
  UPDATE_STATUS
  NONE
}

enum SuggestionStatus {
  PENDING
  CONFIRMED
  DISMISSED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications JobApplication[]
  resumes Resume[]

  gmailConnection GmailConnection?
  processedEmails ProcessedEmail[]

  @@map("users")
}

model JobApplication {
  id        String            @id @default(uuid())
  company   String
  position  String
  status    ApplicationStatus @default(APPLIED)

  salaryMin Int?
  salaryMax Int?
  location  String?
  jobUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  resumeId String?
  resume   Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  history    ApplicationHistory[]
  interviews Interview[]
  notes      ApplicationNote[]

  matchedByEmails ProcessedEmail[]

  @@index([userId])
  @@index([status])
  @@index([resumeId])
  @@map("job_applications")
}

model ApplicationHistory {
  id String @id @default(uuid())

  fromStatus ApplicationStatus?
  toStatus   ApplicationStatus

  changedAt DateTime @default(now())

  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([changedAt])
  @@map("application_history")
}

model Interview {
  id        String   @id @default(uuid())
  title     String
  scheduledAt DateTime
  location  String?
  meetingUrl String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([scheduledAt])
  @@map("interviews")
}

model ApplicationNote {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_notes")
}

model Resume {
  id           String   @id @default(uuid())
  name         String
  originalName String
  storedName   String
  mimeType     String
  size         Int
  filePath     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  applications JobApplication[]

  @@index([userId])
  @@index([createdAt])
  @@map("resumes")
}

/** One Gmail account connected per user via OAuth. Access/refresh tokens are
 * stored encrypted at rest (see email-sync/encryption.ts) — never logged or
 * returned to the client. */
model GmailConnection {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email                 String
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  tokenExpiresAt        DateTime
  scope                 String

  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gmail_connections")
}

/** One row per Gmail message a sync run has looked at — doubles as the
 * dedup ledger (unique on userId+gmailMessageId, checked before an email is
 * ever re-fetched or re-classified) and the review queue for the user to
 * confirm or dismiss a detected application update. */
model ProcessedEmail {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  gmailMessageId String
  gmailThreadId  String?
  subject        String?
  fromAddress    String?
  receivedAt     DateTime?

  detectedType DetectedEmailType
  confidence   Float

  extractedCompany  String?
  extractedPosition String?
  extractedDate     DateTime?
  extractedSource   String?

  suggestedAction SuggestedAction
  status          SuggestionStatus @default(PENDING)

  matchedApplicationId String?
  matchedApplication   JobApplication? @relation(fields: [matchedApplicationId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@unique([userId, gmailMessageId])
  @@index([userId, status])
  @@map("processed_emails")
}
# Copy this file to .env and adjust as needed. Used by `docker compose` to configure
# the postgres, backend, and frontend services. Never commit the real .env file.
#
# Local development (base + docker-compose.override.yml, auto-loaded):
#   docker compose up -d --build
#
# Production (base + docker-compose.prod.yml; the override file is NOT loaded):
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# For production, every value marked "REQUIRED IN PROD" below must be a fresh,
# strong secret — never the dev placeholder. Generate them with:
#   openssl rand -base64 48   # JWT_SECRET
#   openssl rand -base64 32   # EMAIL_SYNC_ENCRYPTION_KEY
#   openssl rand -base64 24   # POSTGRES_PASSWORD
# Inject secrets via your host's secret manager / a root-only .env file — do not
# bake them into images and do not commit them.

# --- Postgres ---
POSTGRES_USER=jobtracker
# REQUIRED IN PROD: strong random value (openssl rand -base64 24).
POSTGRES_PASSWORD=jobtracker
POSTGRES_DB=jobtracker
# Host port for local dev only (bound to 127.0.0.1 via docker-compose.override.yml).
# The production compose file never publishes Postgres.
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=3000
# REQUIRED IN PROD: fresh strong random value, never the dev default
# (openssl rand -base64 48). The backend refuses to start without it.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
# Comma-separated allowlist of browser origins permitted to call the API.
# REQUIRED IN PROD (docker-compose.prod.yml enforces it): the deployed web app
# origin, plus the published browser-extension origin if you ship the extension:
#   FRONTEND_ORIGIN=https://app.example.com,chrome-extension://<published-id>
FRONTEND_ORIGIN=http://localhost:5173

# --- Gmail email sync (optional) ---
# Leave all four blank/default to run without this feature — the backend
# boots normally either way. See backend/.env.example for what each does.
# In prod, use a dedicated OAuth client and point the redirect URI at the
# deployed frontend. GOOGLE_CLIENT_SECRET is a real secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/email-sync
# REQUIRED IN PROD *if* Gmail sync is enabled (openssl rand -base64 32).
# Changing it invalidates every stored Gmail connection (users reconnect).
EMAIL_SYNC_ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- "Continue with Google" sign-in (optional) ---
# Reuses GOOGLE_CLIENT_ID above for a separate, minimal openid/email sign-in
# grant (no secret or redirect URI involved) — see backend/.env.example for
# details. Leave blank to leave the login page's Google button in its
# "coming soon" state. VITE_GOOGLE_CLIENT_ID below must be the same value.

# --- Transactional email (optional) ---
# Leave both blank to run without sending real password-reset emails — the
# backend boots normally either way and just logs the reset link instead.
# See backend/.env.example for details. BREVO_API_KEY is a real secret.
BREVO_API_KEY=
MAIL_FROM=

# --- Frontend ---
FRONTEND_PORT=5173
# Baked into the frontend's JS bundle at image build time (not read at container
# startup) — must be a URL the browser can reach.
# REQUIRED IN PROD (docker-compose.prod.yml enforces it): the public backend URL,
# e.g. https://api.example.com
VITE_API_BASE_URL=http://localhost:3000
# Same Google OAuth client ID as GOOGLE_CLIENT_ID above — safe to expose in
# the browser bundle (it's not a secret, just an identifier). Leave blank to
# leave the login page's "Continue with Google" button in its disabled
# "coming soon" state.
VITE_GOOGLE_CLIENT_ID=
